# Local development uses APP_ENV=development and the local Spring service.
# DATABASE_URL selects the database for this local run: point it at localhost
# for an isolated local PostgreSQL database, or at Neon to share cloud data.
# Keep Neon's pooled hostname (-pooler) when using Neon.
DATABASE_URL=

# Production uses the same code with APP_ENV=production and database/service
# URLs configured in Render/Vercel environment settings, not in this local file.
# Never put production credentials in this file or commit a real .env file.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BYTES=52428800
SPRING_API_BASE_URL=http://127.0.0.1:8083
ROADGUARD_PYTHON_API_BASE_URL=http://127.0.0.1:8001
DB_POOL_MAX_SIZE=8

# Optional overrides. start_roadguard.ps1 derives these from DATABASE_URL when omitted.
# SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=USER
# SPRING_DATASOURCE_PASSWORD=PASSWORD
