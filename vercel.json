{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix roadguard-admin/dashboard",
  "buildCommand": "npm run build",
  "outputDirectory": "vercel-dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://flipkart-python-service.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://flipkart-python-service.onrender.com/auth/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/ui/index.html"
    },
    {
      "source": "/employee",
      "destination": "/admin/ui/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ]
}
